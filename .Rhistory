# Example usage:
y <- comment_k4base3$score
lambda <- 0.2  # Try multiple values to test fit
y_transformed <- manly_transform(y, lambda)
manly_transform <- function(y, lambda) {
if (lambda == 0) {
return(y)
} else {
return((exp(lambda * y) - 1) / lambda)
}
}
y_transformed <- manly_transform(y, lambda)
y_transformed
hist(y_transformed)
qqnorm(y_transformed);qqline(y_transformed,col='blue')
library(moments)
install.packages("moments")
library(moments)
lambdas <- seq(-1, 1, length.out = 100)
y
skews <- sapply(lambdas, function(l) skewness(manly_transform(y, l)))
best_lambda <- lambdas[which.min(abs(skews))]
best_lambda
y_best <- manly_transform(y, best_lambda)
qqnorm(y_best);qqline(y_best,col='blue')
