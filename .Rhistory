cm_feature1 <- cm_feature[-idx_t1,] # 1118476 12
comment_k4base <- merge(comment_k4,cm_feature1,by = 'id',all.x=TRUE) # 56111 140
ind_na <- which(is.na(comment_k4base$t1_sequence))
comment_k4base1 <- comment_k4base[-ind_na,]  # 28472 140
corr_mat <- cor(comment_k4base1[,pre.select],use='pairwise.complete.obs',method='pearson')
# set 0.5 as the threshold here
pos <- which(abs(corr_mat)>0.5 & row(corr_mat) != col(corr_mat),arr.ind=TRUE) # 108 2
value1 <- c()
for(i in 1:nrow(pos)){
value1[i] <- corr_mat[pos[i,1],pos[i,2]]
}
select_name <- data.frame()
for(i in 1:nrow(pos)){
select_name[i,1] <- pre.select[pos[i,1]]
select_name[i,2] <- pre.select[pos[i,2]]
}
rm.variable1 <- c("pronoun","Clout","Tone","ppron","you","det","auxverb","Drives","Cognition","differ","discrep","Affect","emotion","emo_pos",
"emo_neg","Social","socbehav","prosocial","socbehav","Culture","Lifestyle","Physical","health","want","Perception",
"Conversation")
rm.variable1 <- unique(rm.variable1)
ind1 <- c()
for(i in 1:nrow(select_name)){
if(select_name[i,1] %in% rm.variable1 | select_name[i,2] %in% rm.variable1){
ind1[i] <- 1
}else{
ind1[i] <- 0
}
}
pre.select1 <- pre.select[!(pre.select %in% rm.variable1)]
# identify numeric vs categorical columns
is_num  <- sapply(comment_k4base1, is.numeric)
# impute numerics with mean
for(col in names(comment_k4base1)[is_num]) {
m <- mean(comment_k4base1[[col]], na.rm = TRUE)
comment_k4base1[[col]][is.na(comment_k4base1[[col]])] <- m
}
